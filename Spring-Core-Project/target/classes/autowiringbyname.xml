<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	
	 <bean id="inventory" class="com.rays.autowiring.byname.Inventory">
		<property name="stock" value="100"></property>
	</bean>
	
	<!--  Payment Bean-->
	<bean id="payment" class="com.rays.autowiring.byname.Payment">
		<property name="balance" value="700"></property>
	</bean>
	
	<!--  Order Bean -->
	<bean id="order" class="com.rays.autowiring.byname.Order" autowire="byName">
	</bean>
</beans>