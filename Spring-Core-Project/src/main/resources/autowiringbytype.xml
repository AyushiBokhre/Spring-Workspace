<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	
	 <bean id="inv" class="com.rays.autowiring.bytype.Inventory">
		<property name="stock" value="100"></property>
	</bean>
	
	<!--  Payment Bean-->
	<bean id="pay" class="com.rays.autowiring.bytype.Payment">
		<property name="balance" value="7000"></property>
	</bean>
	
	<!--  Order Bean -->
	<bean id="order" class="com.rays.autowiring.bytype.Order" autowire="byType">
	</bean>
</beans>